# ---- server ----
PORT=4173
DATA_DIR=.data
NODE_ENV=development

# ---- logging ----
# debug | info | warn | error | silent
LOG_LEVEL=info
# set to "json" to force structured output even on a TTY
LOG_FORMAT=

# ---- monitor ----
# Base cadence. The scheduler adapts around this: it tightens to MIN near a drop
# window and widens up to MAX when nothing has moved for a while.
MONITOR_INTERVAL_MS=30000
# Per (watch, store) alert cooldown. Damps a store flapping across the boundary.
ALERT_COOLDOWN_MS=600000
# Set to 1 to run the API without the background monitor (useful for serverless web tier)
DISABLE_MONITOR=

# ---- upstream (Apple) politeness ----
FRESH_TTL_MS=12000
STALE_TTL_MS=600000
FETCH_TIMEOUT_MS=7000
FETCH_RETRIES=2
# Max simultaneous in-flight requests to Apple
UPSTREAM_CONCURRENCY=3
# Sustained request rate to Apple (token bucket refill per second)
UPSTREAM_RPS=1.5

# ---- abuse limits ----
RATE_LIMIT=180
MAX_WATCHES_PER_SESSION=24

# ---- optional offline push ----
# Bark, e.g. https://api.day.app/<key>
BARK_URL=
# ntfy topic, e.g. https://ntfy.sh/<topic>
NTFY_URL=

# ---- server ----
PORT=4173
DATA_DIR=.data
NODE_ENV=development

# ---- logging ----
# debug | info | warn | error | silent
LOG_LEVEL=info
# set to "json" to force structured output even on a TTY
LOG_FORMAT=

# ---- monitor ----
# Base cadence. The scheduler adapts around this: it tightens to MIN near a drop
# window and widens up to MAX when nothing has moved for a while.
MONITOR_INTERVAL_MS=30000
# Slowest cadence while watches exist but nothing is moving. Idle and pre-launch sleeps
# can still go longer; this caps worst-case detection delay for a live watch.
MONITOR_QUIET_MAX_MS=60000
# Per (watch, store) alert cooldown. Damps a store flapping across the boundary.
ALERT_COOLDOWN_MS=600000
# Set to 1 to run the API without the background monitor (useful for serverless web tier)
DISABLE_MONITOR=
# The page's "停止全部监控" switch pauses monitoring for every user (persists across restarts).
# Set to 0 on a shared deployment to remove the switch; GET /api/monitor still reports state.
MONITOR_CONTROL=

# ---- upstream (Apple) politeness ----
FRESH_TTL_MS=12000
# The page's background auto-refresh reuses cached readings up to this age instead of
# querying Apple every 15s. Manual refreshes always use FRESH_TTL_MS.
PAGE_REFRESH_MAX_AGE_MS=120000
STALE_TTL_MS=600000
FETCH_TIMEOUT_MS=7000
FETCH_RETRIES=2
# Max simultaneous in-flight requests to Apple
UPSTREAM_CONCURRENCY=3
# Sustained request rate to Apple (token bucket refill per second)
UPSTREAM_RPS=1.5

# ---- abuse limits ----
RATE_LIMIT=180
MAX_WATCHES_PER_SESSION=24

# ---- optional offline push ----
# Bark, e.g. https://api.day.app/<key>
BARK_URL=
# Ringtone name as listed in the Bark app (tap one there to preview). Empty = iOS default.
BARK_SOUND=alarm
# 1 = repeat the ringtone for ~30s until the notification is touched, 0 = ring once
BARK_CALL=1
# timeSensitive: breaks through Focus | critical: also rings on silent (uses BARK_VOLUME)
# active: plain notification | passive: silent, notification centre only
BARK_LEVEL=timeSensitive
# 0-10, critical level only
BARK_VOLUME=10
# ntfy topic, e.g. https://ntfy.sh/<topic>
NTFY_URL=
# Feishu group custom bot webhook, e.g. https://open.feishu.cn/open-apis/bot/v2/hook/<id>
FEISHU_WEBHOOK_URL=
# Only if the bot has "签名校验" enabled
FEISHU_SECRET=
# WeCom (企业微信) group bot webhook, e.g. https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<key>
WECOM_WEBHOOK_URL=
# PushPlus token (delivers to personal WeChat via the PushPlus official account)
PUSHPLUS_TOKEN=

# ---- statistics ----
# Days of arrival statistics kept under DATA_DIR/stats (one events + one counters file per day)
STATS_RETENTION_DAYS=30
